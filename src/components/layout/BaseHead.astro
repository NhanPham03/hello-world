---
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "@/head.const";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL("rss.xml", Astro.site)} />
<link rel="canonical" href={canonicalURL} />

<!-- Preload Fonts -->
<link rel="preload" href="/fonts/noto-sans-jp-regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/m-plus-1p-regular.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/ibm-plex-mono-regular.woff2" as="font" type="font/woff2" crossorigin />

<!-- Primary Meta Tags -->
<title>{SITE_TITLE} | {title}</title>
<meta name="title" content={`${SITE_TITLE} | ${title}`} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
{image && <meta property="og:image" content={new URL(image.src, Astro.site)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:url" content={canonicalURL} />
{image && <meta name="twitter:image" content={new URL(image.src, Astro.site)} />}